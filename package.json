{
  "name": "tipalit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm --filter @tipalit/web dev",
    "dev:web": "corepack pnpm --filter @tipalit/web dev",
    "dev:mobile": "corepack pnpm --filter @tipalit/mobile start",
    "build": "corepack pnpm --filter @tipalit/web build",
    "build:web": "corepack pnpm --filter @tipalit/web build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "format": "corepack pnpm -r --if-present format",
    "test:shapes": "node --test functions/test/shapes.test.mjs",
    "test:rules": "node functions/test/run-rules.mjs",
    "test": "corepack pnpm run test:shapes && corepack pnpm run test:rules"
  }
}
