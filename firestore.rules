rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isAuthenticated() {
      return request.auth != null;
    }

    // A TIP student: verified @tip.edu.ph Google account. email_verified is
    // the trust boundary — without it anyone can register a look-alike
    // address and pass the domain check.
    function isTipStudent() {
      return isAuthenticated() &&
        request.auth.token.email.matches('.*@tip[.]edu[.]ph$') &&
        request.auth.token.email_verified == true;
    }

    // Admins are Office of Student Affairs staff. The token email is the
    // only self-contained trust anchor; the profile role is secondary so an
    // admin can be granted without a rules deploy, but an owner update can
    // never write role/status (see users_profile below), so it cannot be
    // self-escalated.
    function isAdmin() {
      return isTipStudent() && (
        request.auth.token.email in ['osa.admin@tip.edu.ph'] ||
        (exists(/databases/$(database)/documents/users_profile/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users_profile/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isTipStudent() && request.auth.uid == userId;
    }

    function isChatParticipant(chatId) {
      return isTipStudent() && (
        get(/databases/$(database)/documents/chats/$(chatId)).data.buyer_id == request.auth.uid ||
        get(/databases/$(database)/documents/chats/$(chatId)).data.seller_id == request.auth.uid
      );
    }

    // ---------- 1. users_profile ----------

    match /users_profile/{userId} {
      allow read: if isTipStudent();
      // Created by the owner on first sign-in; privileged fields are pinned.
      allow create: if isOwner(userId)
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.is_verified == true
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'active';
      // Owners may edit their card, but never role, status, is_verified,
      // average_rating, or total_reviews — those belong to the server/admin.
      allow update: if (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['full_name', 'campus', 'department', 'program', 'year',
                      'safetyAcceptedAt', 'onboardedAt', 'joinedAt', 'updated_at']))
        // Admins moderate accounts: status is the only extra key they may
        // write, and it is limited to the two account states.
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['full_name', 'campus', 'department', 'program', 'year',
                      'safetyAcceptedAt', 'onboardedAt', 'joinedAt', 'updated_at',
                      'status'])
          && request.resource.data.status in ['active', 'suspended']);
      allow delete: if isAdmin();
    }

    // ---------- 2. listings ----------

    function listingOwnerOrAdmin() {
      return isTipStudent() && (
        resource.data.seller_id == request.auth.uid || isAdmin()
      );
    }

    match /listings/{listingId} {
      // 'hidden' and 'removed' are both moderated states: invisible to the
      // feed, still readable by the seller and admins for context.
      function isModerated() {
        return resource.data.status == 'hidden' || resource.data.status == 'removed';
      }
      // The feed is a LIST query (`campus ==` + `status not-in [...]`), and
      // Firestore evaluates a list against the rules by proving every document
      // it could return is readable. A disjunction the query cannot prove
      // false denies the whole feed, so the list path is written as a single
      // provable condition: the query must exclude both moderated values
      // itself. Single-document reads keep the richer owner/admin branch.
      allow get: if isTipStudent() && (
        !isModerated() ||
        resource.data.seller_id == request.auth.uid ||
        isAdmin()
      );
      allow list: if isTipStudent();
      // Sellers create their own listings; moderation fields start clean.
      allow create: if isTipStudent()
        && request.resource.data.seller_id == request.auth.uid
        && request.resource.data.report_count == 0
        && request.resource.data.status == 'active';
      // Only two moderated values exist: 'removed' (admin takedown) and, as
      // legacy, 'hidden'. Neither is writable by a seller — a seller may only
      // move between the three public states. An admin may additionally write
      // 'removed'. This is the entire takedown mechanism: there is no
      // auto-hide, so nothing else ever sets a moderated status.
      //
      // report_count is intentionally unwritable by EVERYONE, sellers and
      // admins alike. It is a server-maintained counter; with no Cloud
      // Functions it currently never moves (see INFO.md), and a client write
      // would let a seller reset their own flag count.
      allow update: if listingOwnerOrAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['report_count'])
        && request.resource.data.status in (
             isAdmin() ? ['active', 'reserved', 'sold', 'removed'] : ['active', 'reserved', 'sold']
           );
      allow delete: if listingOwnerOrAdmin();
    }

    // ---------- 3. chats + 4. messages ----------

    match /chats/{chatId} {
      allow read: if isTipStudent() && (
        resource.data.buyer_id == request.auth.uid ||
        resource.data.seller_id == request.auth.uid ||
        isAdmin()
      );
      // Only the buyer can open a thread; the listing's seller is copied
      // from the listing document, not trusted from the request.
      allow create: if isTipStudent()
        && request.resource.data.buyer_id == request.auth.uid
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listing_id))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.seller_id
             == request.resource.data.seller_id;
      // Participants may touch only chat metadata (typing, updated_at,
      // last message); meetup/rating state lives on messages.
      allow update: if isChatParticipant(chatId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['updated_at', 'typing_buyer', 'typing_seller',
                       'last_message', 'listing_status']);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId) || isAdmin();
        // Only a chat participant may append, as themselves. Non-participants
        // cannot inject messages into someone else's thread.
        allow create: if isChatParticipant(chatId)
          && request.resource.data.sender_id == request.auth.uid;
        // Meetup responses/completions and ratings update existing messages.
        // A rating can only be set once (immutable after completion).
        allow update: if (isChatParticipant(chatId) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'completed', 'rating', 'rating_comment',
                         'reviewer_id', 'reviewee_id', 'updated_at'])
          && (resource.data.rating == null ||
              request.resource.data.rating == resource.data.rating);
        allow delete: if isAdmin();
      }
    }

    // ---------- 5. reviews ----------

    match /reviews/{reviewId} {
      allow read: if isTipStudent();
      // The reviewer is the caller; the reviewee must differ; rating is 1-5.
      allow create: if isTipStudent()
        && request.resource.data.reviewer_id == request.auth.uid
        && request.resource.data.reviewer_id != request.resource.data.reviewee_id
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      // Reviews are immutable once written; aggregation is server-side.
      allow update, delete: if isAdmin();
    }

    // ---------- 6. reports ----------

    match /reports/{reportId} {
      // Reporters create; one report per reporter per target is enforced by
      // the client's deterministic doc id (reporter uid + target hashed, see
      // src/services/firebase/reports.ts). No Cloud Function exists on the
      // current plan, so report_count is never incremented and nothing
      // auto-hides a listing here.
      allow create: if isTipStudent()
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if isTipStudent() && (
        resource.data.reporter_id == request.auth.uid || isAdmin()
      );
      // Only admins resolve; the resolution note and action are theirs.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- 7. promotions ----------

    match /promotions/{promoId} {
      allow read: if isTipStudent() && resource.data.active == true;
      allow write: if isAdmin();
    }

    // ---------- 8. settings ----------

    match /settings/{settingId} {
      // Readable only by verified members, not the public.
      allow read: if isTipStudent();
      allow write: if isAdmin();
    }

    // ---------- 8b. promotion_clicks ----------

    match /promotion_clicks/{clickId} {
      // Affiliate click tracking (PRD FR-7.4): members log their own clicks,
      // admins read the aggregate. IDs are unguessable and the payload is
      // minimal, so no read is exposed to members.
      allow create: if isTipStudent()
        && request.resource.data.promotion_id is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- 9. audit_log ----------

    match /audit_log/{auditId} {
      allow read: if isAdmin();
      // Append-only: admins create, nobody updates or deletes.
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- 10. analytics_events ----------

    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      // Members log their own events (listing views, perk clicks, searches).
      allow create: if isTipStudent()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
